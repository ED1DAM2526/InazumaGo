<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.canvas.Canvas?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="es.iesquevedo.controller.GameController"
            prefWidth="900" prefHeight="800">

    <!-- TOP: Información de jugadores y tiempo -->
    <top>
        <VBox spacing="10" style="-fx-border-color: #CCCCCC; -fx-border-width: 0 0 2 0;">
            <padding>
                <Insets top="10" bottom="10" left="15" right="15"/>
            </padding>
            
            <!-- Nombres de jugadores y marcador -->
            <HBox spacing="20" alignment="CENTER">
                <!-- Jugador 1 (Negro) -->
                <VBox spacing="5" style="-fx-border-color: #333333; -fx-border-width: 2; -fx-padding: 10;">
                    <Label fx:id="player1NameLabel" text="Jugador 1 (Negro)" 
                           style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label fx:id="player1ScoreLabel" text="Puntos: 0" 
                           style="-fx-font-size: 12;"/>
                    <Label fx:id="player1TimeLabel" text="Tiempo: 00:00" 
                           style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                </VBox>

                <!-- VS -->
                <Label text="VS" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                <!-- Jugador 2 (Blanco) -->
                <VBox spacing="5" style="-fx-border-color: #FFFFFF; -fx-border-width: 2; -fx-padding: 10; -fx-background-color: #F5F5F5;">
                    <Label fx:id="player2NameLabel" text="Jugador 2 (Blanco)" 
                           style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label fx:id="player2ScoreLabel" text="Puntos: 0" 
                           style="-fx-font-size: 12;"/>
                    <Label fx:id="player2TimeLabel" text="Tiempo: 00:00" 
                           style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                </VBox>
            </HBox>

            <!-- Turno actual -->
            <Label fx:id="currentTurnLabel" text="Turno: Jugador 1" 
                   style="-fx-font-size: 12; -fx-text-alignment: center;"
                   alignment="CENTER"/>
        </VBox>
    </top>

    <!-- CENTER: Tablero -->
    <center>
        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: #F0F0F0;">
            <padding>
                <Insets top="15" bottom="15" left="15" right="15"/>
            </padding>
            
             <!-- Canvas para el tablero -->
            <Canvas fx:id="boardCanvas" width="550" height="550"
                    style="-fx-border-color: #000000; -fx-border-width: 1;"/>
        </VBox>
    </center>

    <!-- BOTTOM: Controles -->
    <bottom>
        <VBox spacing="10" style="-fx-border-color: #CCCCCC; -fx-border-width: 2 0 0 0;">
            <padding>
                <Insets top="10" bottom="10" left="15" right="15"/>
            </padding>
            
            <HBox spacing="10" alignment="CENTER">
                <Button text="Pasar turno" onAction="#onPassTurn"
                        style="-fx-padding: 8px 20px; -fx-font-size: 12;"/>
                <Button text="Deshacer" onAction="#onUndo"
                        style="-fx-padding: 8px 20px; -fx-font-size: 12;"/>
                <Button text="Rendirse" onAction="#onSurrender"
                        style="-fx-padding: 8px 20px; -fx-font-size: 12; -fx-text-fill: red;"/>
                <Button text="Volver al menú" onAction="#onBackToMenu"
                        style="-fx-padding: 8px 20px; -fx-font-size: 12;"/>
            </HBox>
            
            <Label fx:id="statusLabel" text=""
                   style="-fx-font-size: 11; -fx-text-fill: #666666;"
                   wrapText="true" alignment="CENTER"/>
        </VBox>
    </bottom>
</BorderPane>
