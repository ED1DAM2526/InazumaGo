<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.canvas.Canvas?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="es.iesquevedo.controller.GameController"
            prefWidth="900" prefHeight="800">

    <!-- TOP: Información de jugadores y tiempo -->
    <top>
        <VBox spacing="15" style="-fx-border-color: #CCCCCC; -fx-border-width: 0 0 2 0; -fx-padding: 15;">
            <padding>
                <Insets top="10" bottom="10" left="15" right="15"/>
            </padding>
            
            <!-- Nombres de jugadores y marcador -->
            <HBox spacing="30" alignment="CENTER">
                <!-- Jugador 1 (Negro) -->
                <VBox fx:id="player1Box" spacing="8" style="-fx-border-color: #333333; -fx-border-width: 3; -fx-padding: 15; -fx-border-radius: 8; -fx-background-color: #F0F0F0;">
                    <Label fx:id="player1NameLabel" text="Jugador 1 (Negro)"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
                    <Label fx:id="player1ScoreLabel" text="Puntos: 0"
                           style="-fx-font-size: 13; -fx-text-fill: #333333;"/>
                    <Label fx:id="player1TimeLabel" text="Tiempo: 00:00"
                           style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                </VBox>

                <!-- VS -->
                <Label text="VS" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #FF6B6B;"/>

                <!-- Jugador 2 (Blanco) -->
                <VBox fx:id="player2Box" spacing="8" style="-fx-border-color: #CCCCCC; -fx-border-width: 3; -fx-padding: 15; -fx-background-color: #FFFFFF; -fx-border-radius: 8;">
                    <Label fx:id="player2NameLabel" text="Jugador 2 (Blanco)"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
                    <Label fx:id="player2ScoreLabel" text="Puntos: 0"
                           style="-fx-font-size: 13; -fx-text-fill: #333333;"/>
                    <Label fx:id="player2TimeLabel" text="Tiempo: 00:00"
                           style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                </VBox>
            </HBox>

            <!-- Turno actual - Resaltado dinámico -->
            <Label fx:id="currentTurnLabel" text="📍 Turno: Negro"
                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-alignment: center; -fx-text-fill: #1E90FF; -fx-padding: 8; -fx-border-radius: 5; -fx-background-color: #E8F4FF;"
                   alignment="CENTER"/>
        </VBox>
    </top>

    <!-- CENTER: Tablero -->
    <center>
        <StackPane alignment="CENTER"
                   style="-fx-background-color: linear-gradient(to bottom, #F7F2E8, #E7DFD0); -fx-border-color: rgba(0,0,0,0.12); -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 18, 0.18, 0, 6);">
            <padding>
                <Insets top="15" bottom="15" left="15" right="15"/>
            </padding>

            <!-- Canvas para el tablero centrado -->
            <Canvas fx:id="boardCanvas" width="550" height="550"
                    style="-fx-border-color: #000000; -fx-border-width: 1;"
                    StackPane.alignment="CENTER"/>
        </StackPane>
    </center>

    <!-- BOTTOM: Controles -->
    <bottom>
        <VBox spacing="5" style="-fx-border-color: #CCCCCC; -fx-border-width: 2 0 0 0;">
            <padding>
                <Insets top="5" bottom="5" left="15" right="15"/>
            </padding>
            
            <HBox spacing="10" alignment="CENTER">
                <Button text="Pasar turno" onAction="#onPassTurn"
                        style="-fx-padding: 8px 20px; -fx-font-size: 12; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand; -fx-border-radius: 5;"/>
                <Button text="Deshacer" onAction="#onUndo"
                        style="-fx-padding: 8px 20px; -fx-font-size: 12; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand; -fx-border-radius: 5;"/>
                <Button text="Rendirse" onAction="#onSurrender"
                        style="-fx-padding: 8px 20px; -fx-font-size: 12; -fx-background-color: #F44336; -fx-text-fill: white; -fx-cursor: hand; -fx-border-radius: 5;"/>
                <Button text="Volver al menú" onAction="#onBackToMenu"
                        style="-fx-padding: 8px 20px; -fx-font-size: 12; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-cursor: hand; -fx-border-radius: 5;"/>
            </HBox>
            
            <Label fx:id="statusLabel" text=""
                   style="-fx-font-size: 11; -fx-text-fill: #666666;"
                   wrapText="true" alignment="CENTER"/>
        </VBox>
    </bottom>
</BorderPane>
