<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="es.iesquevedo.controller.LoginController"
      spacing="15" alignment="CENTER"
      style="-fx-padding: 40; -fx-background-color: #1e1e2e;" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>

    <Label text="Inazuma Go — Login"
           style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <TextField fx:id="emailField"
               promptText="Email"
               style="-fx-pref-width: 280;"/>

    <PasswordField fx:id="passwordField"
                   promptText="Contraseña"
                   style="-fx-pref-width: 280;"/>

    <Button text="Iniciar sesión"
            onAction="#handleLogin"
            style="-fx-pref-width: 280; -fx-background-color: #7c3aed; -fx-text-fill: white;"/>

    <Label fx:id="statusLabel"
           text=""
           style="-fx-font-size: 13;"/>
</VBox>

