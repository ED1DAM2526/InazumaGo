<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="450.0" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.iesquevedo.controller.LoginController">
    <center>
        <VBox alignment="CENTER" prefHeight="400.0" prefWidth="450.0" spacing="15.0" style="-fx-background-color: #1a1a1a;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <Label text="InazumaGo" textFill="#ffffff">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>
            <Label text="Iniciar sesión" textFill="#cccccc">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
            <Separator prefWidth="200.0" style="-fx-border-color: #333333;" />
            <VBox spacing="10.0">
                <Label text="Email" textFill="#cccccc">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="emailField" prefHeight="40.0" promptText="tu.email@ejemplo.com" style="-fx-font-size: 14; -fx-padding: 10;" />
            </VBox>
            <VBox spacing="10.0">
                <Label text="Contraseña" textFill="#cccccc">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
                <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Tu contraseña" style="-fx-font-size: 14; -fx-padding: 10;" />
            </VBox>
            <Label fx:id="statusLabel" textFill="#ff3333" wrapText="true" />
            <Button onAction="#onLoginClicked" prefHeight="40.0" prefWidth="200.0" style="-fx-font-size: 14; -fx-padding: 10; -fx-background-color: #4db8ff; -fx-text-fill: white; -fx-cursor: hand;" text="Iniciar sesión" />
            <HBox alignment="CENTER" spacing="10.0">
                <Button onAction="#onClearClicked" prefHeight="35.0" prefWidth="100.0" style="-fx-font-size: 12; -fx-padding: 8; -fx-background-color: #333333; -fx-text-fill: #cccccc; -fx-cursor: hand;" text="Limpiar" />
                <Button fx:id="registerButton" onAction="#onRegisterClicked" prefHeight="35.0" prefWidth="100.0" style="-fx-font-size: 12; -fx-padding: 8; -fx-background-color: #228B22; -fx-text-fill: white; -fx-cursor: hand;" text="Registrarse" />
            </HBox>
            <Label text="¿No tienes cuenta? Haz clic en Registrarse" textFill="#999999">
                <font>
                    <Font size="10.0" />
                </font>
            </Label>
        </VBox>
    </center>
</BorderPane>

