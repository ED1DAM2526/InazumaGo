<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="es.iesquevedo.ui.MainFXController"
      spacing="20" style="-fx-padding: 40; -fx-alignment: center;">

    <Label fx:id="saludoLabel" text="Cargando..." style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label fx:id="tokenLabel" text="" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>

    <Button text="Cerrar sesión" onAction="#handleLogout" style="-fx-min-width: 120px;"/>
</VBox>

