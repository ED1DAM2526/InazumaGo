<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.iesquevedo.controller.MainController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" padding="10">
            <children>
                <Button fx:id="btnNewGame" text="Nueva partida" onAction="#onNewGame" />
                <Label fx:id="lblStatus" text="Bienvenido" />
            </children>
        </HBox>
    </top>

    <center>
        <GridPane fx:id="boardGrid" hgap="2" vgap="2" alignment="CENTER" padding="10">
            <!-- Las celdas se generan dinámicamente desde el controlador si es necesario -->
        </GridPane>
    </center>
</BorderPane>
