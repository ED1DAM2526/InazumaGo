<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to right, #1a1a2e, #16213e);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.iesquevedo.controller.MainMenuController">

    <!-- TOP: Header con logo y usuario -->
    <top>
        <VBox spacing="0" style="-fx-background-color: linear-gradient(to right, #0f3460, #1a1a2e); -fx-padding: 20;">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="🎮 InazumaGo" textFill="#FFFFFF" style="-fx-font-size: 32; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="playerEmailLabel" text="👤 Usuario" textFill="#B0E0E6" style="-fx-font-size: 16;"/>
                <Button onAction="#onLogoutClicked" style="-fx-background-color: #FF6B6B; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 8px 15px; -fx-border-radius: 5;" text="🔓 Logout"/>
            </HBox>
            <Separator style="-fx-border-color: #00D4FF; -fx-border-width: 2 0 0 0;" />
        </VBox>
    </top>

    <!-- CENTER: Opciones principales -->
    <center>
        <VBox alignment="CENTER" spacing="40" style="-fx-background-color: #1a1a2e; -fx-padding: 60;">
            <VBox alignment="CENTER" spacing="30">
                <!-- Título -->
                <Label text="¿Qué quieres hacer?" textFill="#FFFFFF" style="-fx-font-size: 40; -fx-font-weight: bold;"/>

                <!-- Divider -->
                <Separator style="-fx-border-color: #00D4FF; -fx-border-width: 2 0 0 0; -fx-max-width: 300;" />

                <!-- Opciones en grid -->
                <HBox spacing="40" alignment="CENTER">

                    <!-- OPCIÓN 1: Emparejamiento -->
                    <VBox spacing="20" style="-fx-border-color: #00D4FF; -fx-border-width: 2; -fx-border-radius: 10; -fx-padding: 30; -fx-background-color: #0f3460; -fx-cursor: hand;" onMouseClicked="#onMatchmakingClicked" HBox.hgrow="ALWAYS">
                        <Label text="⚡" style="-fx-font-size: 60; -fx-text-alignment: center;" alignment="CENTER" textFill="#00D4FF"/>
                        <Label text="Emparejamiento" textFill="#FFFFFF" style="-fx-font-size: 24; -fx-font-weight: bold;" alignment="CENTER"/>
                        <Label text="Juega contra otros jugadores en línea" textFill="#B0B0B0" wrapText="true" style="-fx-font-size: 14;" alignment="CENTER"/>
                        <Button style="-fx-background-color: #00D4FF; -fx-text-fill: #000000; -fx-cursor: hand; -fx-font-size: 14; -fx-padding: 12px 30px; -fx-font-weight: bold; -fx-border-radius: 5;" text="BUSCAR PARTIDA" onAction="#onMatchmakingClicked"/>
                    </VBox>

                    <!-- OPCIÓN 2: Partida Local -->
                    <VBox spacing="20" style="-fx-border-color: #228B22; -fx-border-width: 2; -fx-border-radius: 10; -fx-padding: 30; -fx-background-color: #1a3a1a; -fx-cursor: hand;" onMouseClicked="#onLocalGameClicked" HBox.hgrow="ALWAYS">
                        <Label text="🎯" style="-fx-font-size: 60; -fx-text-alignment: center;" alignment="CENTER" textFill="#228B22"/>
                        <Label text="Partida Local" textFill="#FFFFFF" style="-fx-font-size: 24; -fx-font-weight: bold;" alignment="CENTER"/>
                        <Label text="Partida en local contra otra persona" textFill="#B0B0B0" wrapText="true" style="-fx-font-size: 14;" alignment="CENTER"/>
                        <Button style="-fx-background-color: #228B22; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 14; -fx-padding: 12px 30px; -fx-font-weight: bold; -fx-border-radius: 5;" text="PARTIDA EN LOCAL" onAction="#onLocalGameClicked"/>
                    </VBox>

                    <!-- OPCIÓN 3: Salir -->
                    <VBox spacing="20" style="-fx-border-color: #FF6B6B; -fx-border-width: 2; -fx-border-radius: 10; -fx-padding: 30; -fx-background-color: #3a1a1a; -fx-cursor: hand;" onMouseClicked="#onExitClicked" HBox.hgrow="ALWAYS">
                        <Label text="🚪" style="-fx-font-size: 60; -fx-text-alignment: center;" alignment="CENTER" textFill="#FF6B6B"/>
                        <Label text="Salir" textFill="#FFFFFF" style="-fx-font-size: 24; -fx-font-weight: bold;" alignment="CENTER"/>
                        <Label text="Cerrar la aplicación" textFill="#B0B0B0" wrapText="true" style="-fx-font-size: 14;" alignment="CENTER"/>
                        <Button style="-fx-background-color: #FF6B6B; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 14; -fx-padding: 12px 30px; -fx-font-weight: bold; -fx-border-radius: 5;" text="SALIR" onAction="#onExitClicked"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- BOTTOM: Footer -->
    <bottom>
        <VBox style="-fx-background-color: linear-gradient(to right, #0f3460, #1a1a2e); -fx-padding: 15;" alignment="CENTER">
            <Label text="InazumaGo 2026 - El Go Moderno" textFill="#666666" style="-fx-font-size: 11;"/>
        </VBox>
    </bottom>
</BorderPane>

