<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.iesquevedo.ui.MatchingScreenController"
      spacing="20"
      alignment="CENTER"
      padding="20">

    <Label text="Buscando oponente..." style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <ProgressIndicator/>

    <Label fx:id="statusLabel" text="Buscando jugador disponible..." style="-fx-font-size: 14px;"/>

    <Label fx:id="timeLabel" text="Tiempo de espera: 0s" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="cancelButton" text="Cancelar" onAction="#onCancel" style="-fx-background-color: #ff4444; -fx-text-fill: white;"/>
    </HBox>

</VBox>