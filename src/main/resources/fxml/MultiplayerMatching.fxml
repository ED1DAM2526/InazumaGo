<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="es.iesquevedo.ui.MultiplayerMatchingController"
            prefWidth="600" prefHeight="500">

    <!-- TOP: Título -->
    <top>
        <VBox spacing="10" style="-fx-border-color: #CCCCCC; -fx-border-width: 0 0 2 0;">
            <padding>
                <Insets top="15" bottom="15" left="20" right="20"/>
            </padding>
            <Label text="Emparejamiento Multijugador"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"
                   alignment="CENTER"/>
        </VBox>
    </top>

    <!-- CENTER: Opciones de emparejamiento -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Crear partida -->
            <VBox spacing="10" style="-fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-padding: 15; -fx-border-radius: 8;">
                <Label text="Crear Partida" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                <Label text="Crea una nueva partida y espera a que otro jugador se una desde otro dispositivo."
                       style="-fx-font-size: 11; -fx-wrap-text: true;"/>
                <Button fx:id="createGameButton" text="Crear Partida"
                        style="-fx-padding: 10px 30px; -fx-font-size: 12;"
                        onAction="#onCreateGame"/>
            </VBox>

            <!-- Buscar y unirse a partida -->
            <VBox spacing="10" style="-fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-padding: 15; -fx-border-radius: 8;">
                <Label text="Unirse a Partida" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                <Label text="Busca partidas disponibles creadas por otros jugadores."
                       style="-fx-font-size: 11; -fx-wrap-text: true;"/>

                <HBox spacing="10">
                    <Button fx:id="searchButton" text="Buscar Partidas"
                            style="-fx-padding: 10px 30px; -fx-font-size: 12;"
                            onAction="#onSearchAvailableGames"/>
                    <Label fx:id="timeLabel" text="Tiempo de búsqueda: 0s"
                           style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                </HBox>

                <!-- Lista de partidas disponibles -->
                <Label text="Partidas disponibles:" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                <ListView fx:id="availableGamesListView" prefHeight="120" prefWidth="400"/>

                <Button fx:id="joinGameButton" text="Unirse a Partida Seleccionada"
                        style="-fx-padding: 10px 30px; -fx-font-size: 12;"
                        onAction="#onJoinSelectedGame"/>
            </VBox>

            <!-- Estado -->
            <Label fx:id="statusLabel" text="Listo. Crea una partida o busca jugadores."
                   style="-fx-font-size: 12; -fx-text-fill: #333333; -fx-wrap-text: true;"
                   alignment="CENTER"/>
        </VBox>
    </center>

    <!-- BOTTOM: Botones de control -->
    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 15; -fx-border-color: #CCCCCC; -fx-border-width: 2 0 0 0;">
            <Button fx:id="cancelButton" text="Volver"
                    style="-fx-padding: 10px 30px; -fx-font-size: 12;"
                    onAction="#onCancel"/>
        </HBox>
    </bottom>
</BorderPane>

